# =============================================================================
# AutoApply Agent — backend environment
# Copy to backend/.env  ->  cp .env.example .env
# Anything marked REQUIRED blocks startup if it is missing.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | production
APP_ENV=development
APP_NAME=AutoApply
API_PREFIX=/api

# Public base URL of this API (used to build links in logs and emails).
BACKEND_BASE_URL=http://localhost:8000

# Where the dashboard runs. Used for links and the CORS allowlist.
DASHBOARD_URL=http://localhost:5173

LOG_LEVEL=INFO

# REQUIRED. Signs pairing-code hashes and internal tokens.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret

# Comma-separated. The dashboard is same-origin through the /api proxy, so in
# dev this only matters for direct API calls and tooling.
CORS_ORIGINS=http://localhost:5173



# --- Google Sign-In (REQUIRED) ----------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Add these under "Authorised JavaScript origins":
#   http://localhost:5173
#   https://<your-dashboard-domain>
# No redirect URI is needed for the ID-token flow used in v1.
#
# ONE client ID is enough: the extension does not use OAuth. It authenticates with
# an 8-character pairing code traded for a bearer token, so it never contacts
# Google. Keep all clients in the same Google Cloud *project* if you ever add
# more, so they share one consent screen and one test-user list.
GOOGLE_CLIENT_ID=

# Optional. Extra client IDs whose ID tokens should also be accepted, comma
# separated. Only needed if a second client is ever created (for example an
# extension client using chrome.identity.launchWebAuthFlow). Leave blank for v1.
GOOGLE_EXTRA_CLIENT_IDS=

# NOT used in v1. Only needed if you later switch to the authorization-code
# flow (needed for a fully custom sign-in button). Leave blank.
GOOGLE_CLIENT_SECRET=

# Local-only fake sign-in so you can build without Google configured.
# Ignored unless APP_ENV=development. Never set this in production.
AUTH_DEV_BYPASS=true
AUTH_DEV_BYPASS_EMAIL=you@example.com

# How long a dashboard session lives before the user signs in again.
SESSION_TTL_DAYS=30


# --- Database (REQUIRED in production) ---------------------------------------
# Development fallback: if you leave this blank the app uses a local SQLite file
# (sqlite+aiosqlite:///./.data/dev.db) and creates the tables on startup, so you can
# start coding before Neon exists. Production must set this to the Neon pooled URL.
DATABASE_URL=
# Direct (unpooled) URL, used only by Alembic migrations. Required when running
# migrations against Neon; falls back to DATABASE_URL when blank.
DATABASE_URL_UNPOOLED=

DB_POOL_SIZE=5
DB_ECHO=false


# --- Object storage ----------------------------------------------------------
# local | supabase | s3
#   local    - files on disk under STORAGE_LOCAL_DIR. Development default.
#   supabase - Supabase Storage REST API. Easiest production path: the project's
#              own URL + secret key are enough, no extra key pair needed.
#   s3       - S3 protocol. Works with Supabase too, but needs a separate
#              "S3 access key" generated in the dashboard; an sb_secret_ key is
#              an API key, not a SigV4 credential, so it will not work here.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.data

# --- Supabase Storage (used when STORAGE_BACKEND=supabase) -------------------
# Project URL, no trailing slash.
SUPABASE_URL=
# SECRET key (sb_secret_...). Server-side only: it bypasses row-level security,
# so it must never be shipped to the browser or the extension.
SUPABASE_SECRET_KEY=
# Created automatically on first upload when it does not exist. Keep it private.
SUPABASE_BUCKET=autoapply-private
SUPABASE_AUTO_CREATE_BUCKET=true

# The publishable key and the JWKS URL are for Supabase *Auth*. v1 signs users in
# with Google directly and verifies the ID token itself, so neither is needed.
# If you switch to Supabase Auth later, add them then.

# --- S3 protocol (used when STORAGE_BACKEND=s3) ------------------------------
# Supabase dashboard -> Storage -> S3 access keys -> New access key.
# Endpoint: https://<project-ref>.supabase.co/storage/v1/s3
# Region: the project's real region (e.g. ap-south-1). NOT "auto".
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Lifetime of signed resume/screenshot URLs.
SIGNED_URL_TTL_SECONDS=300


# --- LLM providers -----------------------------------------------------------
# false -> deterministic rules-only mode. Everything except free-text resume
# parsing still works, so you can build and test without keys.
LLM_ENABLED=true

# Groq: classification + short answers (fast tier).
GROQ_API_KEY=
    GROQ_MODEL_FAST=llama-3.3-70b-versatile
    GROQ_MODEL_SMALL=llama-3.1-8b-instant

# NVIDIA Nemotron via the OpenAI-compatible NIM endpoint:
# resume parsing and genuinely hard free-text answers.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Hard ceiling of LLM calls in a single run. Past this, unknowns go to HITL.
LLM_MAX_CALLS_PER_RUN=30
# Deployment ceiling across one quota day. The plan sets the real number
# (regular 60, pro 120, pro plus 200); this can only lower it.
LLM_MAX_CALLS_PER_DAY=200
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2


# --- Tracing (optional, free tier) ------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoapply


# --- Safety governor ---------------------------------------------------------
# Deterministic code. The LLM cannot override these. Values are conservative
# guesses about platform tolerance, not measured limits. Hard ceilings are
# enforced in code and are lower than these comments suggest.
# These two are DEPLOYMENT CEILINGS, not per-user limits. The plan sets the real
# number (regular 10, pro 18, pro plus 25 - app/safety/plans.py) and a user can
# lower their own cap further in Settings. Set these lower to force a stricter
# deployment-wide limit; they can never raise a plan above them.
SAFETY_DAILY_CAP=25
SAFETY_HOURLY_CAP=6
SAFETY_WARMUP_DAYS=14
SAFETY_WARMUP_START_CAP=5

# The quota day rolls over at this LOCAL hour, not at midnight: the day's
# allowance starts in the morning and is spent during the working day. A new
# account ramps from SAFETY_WARMUP_START_CAP up to SAFETY_DAILY_CAP over
# SAFETY_WARMUP_DAYS, so 10/day is the steady-state limit, not day one.
SAFETY_DAY_RESET_HOUR=10
# Timezone used when a user has not chosen one. Each user can set their own in
# Settings; this only decides the default and the fallback for a bad value.
SAFETY_DEFAULT_TIMEZONE=Asia/Kolkata

# Randomised human-like pacing (milliseconds / seconds).
SAFETY_ACTION_DELAY_MIN_MS=400
SAFETY_ACTION_DELAY_MAX_MS=1800
SAFETY_APPLY_PAUSE_MIN_S=45
SAFETY_APPLY_PAUSE_MAX_S=180
SAFETY_LONG_BREAK_EVERY_N=8
SAFETY_LONG_BREAK_MIN_S=240
SAFETY_LONG_BREAK_MAX_S=600

# Cooldown applied after a hard stop (CAPTCHA, checkpoint, warning banner...).
SAFETY_COOLDOWN_HOURS=24

SAFETY_HEARTBEAT_SECONDS=20
SAFETY_HEARTBEAT_TIMEOUT_SECONDS=180
SAFETY_RUN_WINDOW_MINUTES=120
SAFETY_MAX_RUN_APPLICATIONS=15
# Default window for new users; each user can narrow it in Settings.
SAFETY_DEFAULT_ACTIVE_HOURS=09:00-21:00
# One rest day per week (0 = Monday ... 6 = Sunday).
SAFETY_REST_DAY=6


# --- Uploads, retention, ops -------------------------------------------------
UPLOAD_MAX_MB=5
SCREENSHOT_RETENTION_DAYS=14
SESSION_SWEEP_INTERVAL_MINUTES=60

# Protects POST /internal/sweep when it is called by an external cron.
CRON_SECRET=

# Optional error reporting.
SENTRY_DSN=
