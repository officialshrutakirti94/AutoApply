# =============================================================================
# AutoApply Agent — dashboard environment (Vite)
# Copy to dashboard/.env
# Only variables prefixed with VITE_ reach the browser. Never put a secret here.
# =============================================================================

# Leave empty. The app calls /api on its own origin; Vite proxies it to the
# backend in development, and a rewrite does the same in production.
#
# Do NOT set an absolute URL. An absolute base makes every request cross-site,
# so the SameSite=Lax session cookie is never sent and the user looks signed
# out on every call. Same-origin is what makes the cookie work.
VITE_API_BASE_URL=

# REQUIRED in production (baked in at build time). Same Web client ID as the
# backend. Add the dashboard origin to "Authorised JavaScript origins" in Google
# Cloud Console, otherwise the sign-in button renders but fails on click.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Shown in the header and in Settings.
VITE_APP_NAME=AutoApply
VITE_SUPPORT_EMAIL=support@example.com

# Where users download the extension zip. Shown on the onboarding "Ready" step
# and in Settings. Can be a repo release URL or your own hosted file.
VITE_EXTENSION_DOWNLOAD_URL=

# Optional. Leave empty to disable error reporting.
VITE_SENTRY_DSN=

# Dev-only convenience: renders the fake sign-in button. Requires the backend to
# have APP_ENV=development and AUTH_DEV_BYPASS=true.
VITE_ENABLE_DEV_LOGIN=false