# =============================================================================
# AutoApply Agent — extension environment (WXT)
# Copy to extension/.env  (or .env.development / .env.production)
# WXT injects variables prefixed with WXT_ into import.meta.env at build time.
# Anything baked in here ships inside the extension zip and is public. No secrets.
# =============================================================================

# REQUIRED. Where the backend lives. Include the /api suffix.
# Production example: https://autoapply-yyy.onrender.com/api
WXT_API_BASE_URL=http://localhost:8000/api

# REQUIRED. Where users generate a pairing code
# (Settings -> Connect extension). The popup links here.
WXT_DASHBOARD_URL=http://localhost:5173

# debug | info | warn | error
WXT_LOG_LEVEL=debug

# Milliseconds between page observations while a run is active. Keep this slow
# enough that the loop never looks like a robot.
WXT_OBSERVE_INTERVAL_MS=1500

# Local safety floor. The extension refuses to act faster than this even if the
# backend asks it to, so a backend bug cannot turn the loop into a spammer.
WXT_MIN_ACTION_DELAY_MS=250